{
  "name": "chatgpt-thread-exporter",
  "version": "0.1.0",
  "description": "Local-first CLI for exporting ChatGPT shared-link threads to Markdown.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "bin": {
    "chatgpt-thread-exporter": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline.d.ts",
      "import": "./dist/pipeline.js"
    },
    "./pipeline.js": {
      "types": "./dist/pipeline.d.ts",
      "import": "./dist/pipeline.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "marked": "^18.0.13",
    "playwright": "^1.63.0"
  }
}
